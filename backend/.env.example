# Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_ACCESS_CODE=UOJ-SPORTS-ADMIN-2026

# Application URLs
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ==============================================================================
# SMTP Email Notification Configuration (Nodemailer)
# ==============================================================================
# For Gmail:
#   1. Enable 2-Step Verification in Google Account.
#   2. Generate an "App Password" (16 characters) under Security settings.
#   3. Put Gmail address in SMTP_USER and App Password in SMTP_PASS.
#
# For Local Testing / Development (Mailtrap, Ethereal, Brevo, or Custom SMTP):
#   SMTP_HOST=smtp.gmail.com (or sandbox.smtp.mailtrap.io)
#   SMTP_PORT=587 (or 465 for SSL)
#   SMTP_SECURE=false (true for port 465, false for port 587)
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="University of Jaffna Sports" <your-email@gmail.com>
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="University of Jaffna Sports" <your-email@gmail.com>